-- 1. TESTARE DQL (SELECT) - COMPLEXITATE MAXIMA
SELECT DISTINCT nume, AVG(salariu) AS medie FROM angajati JOIN departamente ON angajati.id_dep = departamente.id WHERE salariu > 5000 AND oras = 'Bucuresti' GROUP BY departament HAVING AVG(salariu) > 6000 ORDER BY medie DESC LIMIT 10 OFFSET 5;

-- 2. TESTARE EXPRESII ARITMETICE SI IMBRICARE (ADANCIME ARBORE)
SELECT nume, (salariu * 12) + bonus / 2 FROM angajati WHERE (pret - discount) * 1.19 > 100;

-- 3. TESTARE JOIN-URI MULTIPLE SI TIPURI DIFERITE
SELECT * FROM comenzi LEFT JOIN clienti ON comenzi.id_client = clienti.id RIGHT JOIN livrari ON comenzi.id_livrare = livrari.id;

-- 4. TESTARE DML (INSERT, UPDATE, DELETE)
INSERT INTO utilizatori (id, nume, email) VALUES (101, 'Izabela', 'test@example.com');
UPDATE stocuri SET cantitate = cantitate - 1, status = 'actualizat' WHERE id_produs = 50 AND categorie = 'IT';
DELETE FROM loguri WHERE data_expirare < '2024-01-01' OR status = 'invalid';

--fail, nu avem definit INT
-- 5. TESTARE DDL (CREATE, ALTER, DROP) - DEFINITII COLOANE COMPLEXE
CREATE TABLE angajati (id INT PRIMARY KEY, nume WORD NOT NULL, email WORD UNIQUE, id_dep INT REFERENCES departamente(id), salariu NUMBER DEFAULT 0, CHECK (salariu > 0));
ALTER TABLE clienti ADD COLUMN telefon WORD;
ALTER TABLE produse DROP COLUMN descriere_veche;
DROP TABLE arhiva_2023;

-- 6. TESTARE OPERATORI SPECIALI (LIKE, IN, BETWEEN, IS NULL)
SELECT * FROM produse WHERE denumire LIKE '%laptop%' AND categorie IN ('electronice', 'gadget') AND pret BETWEEN 1000 AND 5000 AND garantie IS NOT NULL;


-- 7. TESTARE AGREGARI SI FILTRARE PE GRUPURI
SELECT id_proiect, SUM(ore_lucrate), MIN(data_start), MAX(data_final) FROM sarcini GROUP BY id_proiect HAVING COUNT(*) > 5;

-- 8. TESTARE COMBINATA (CARTEZIAN)
SELECT * FROM tab1 CROSS JOIN tab2;